# ============================================================================
# THAMJJ13 Enterprise Platform — Environment Configuration
# Storage: Turso (LibSQL) + Cloudinary CDN ONLY
# Transactional Email & OTPs: Resend (no-reply@thamjj13.top)
#
# NOTE FOR RENDER / VERCEL:
# Paste raw values WITHOUT surrounding quotes.
# Get your exact Turso database URL via:
#   turso db show <db-name> --url
#   (Format: libsql://<db-name>-<your-org-slug>.turso.io)
# And generate your auth token via:
#   turso db tokens create <db-name>
# ============================================================================

# 1. Turso Database (https://turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Cloudinary Media & Evidence CDN (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# 3. Resend Transactional Email Gateway (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@thamjj13.top
RESEND_FROM_NAME=THAMJJ13 Security
ADMIN_ALERT_EMAIL=thamjj13@gmail.com

# 4. Authentication & JWT Session Security
JWT_SECRET=

# 5. Optional Initial Super Admin Bootstrap (auto-seeds on first boot if set;
#    if omitted, use the one-time Super Admin Setup screen in Portal Login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=THAMJJ13 Root Command

# 6. Optional Gemini AI CyberTutor Key
GEMINI_API_KEY=
